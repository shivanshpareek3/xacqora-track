{
  "version": 2,
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/admin/tick",
      "schedule": "*/5 * * * *",
      "headers": { "x-xacqora-tick-secret": "{{ process.env.XACQORA_TICK_SECRET }}" }
    }
  ]
}
