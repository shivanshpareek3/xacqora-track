# Xacqora Track — environment variables (Phase H)
# Copy to `.env` (self-hosted) or set in the Vercel dashboard (prod).
# NEVER commit real values: .env is gitignored. Never paste real secrets or
# access tokens into AI chat — use placeholders + the dashboard/env only.

# --- Database (Phase P) ------------------------------------------------------
# Postgres (managed, Mumbai region recommended for pilot latency): the live
# engine. Managed Postgres must expose the app role + the backup role.
DATABASE_URL=postgres://xacq_app:APP_PASSWORD@HOST:5432/xacqora
# Non-superuser role that owns the app's tables (RLS applies to it;
# superusers would bypass FORCE RLS — that would silently disable isolation).
#   create role xacq_app login; create role xacq_backup superuser;
#   grant xacq_app to current;  (see scripts/pg-provision.sh for the dev form)
# Role pg_dump/pg_restore run as (FORCE RLS refuses export by the app role;
# the superuser backup role bypasses it — Phase P restore drill):
PG_BACKUP_USER=xacq_backup
# Leave DATABASE_URL unset to run the zero-dep SQLite fallback instead.

# --- Secrets at rest (Phase S.2) ---------------------------------------------
# 32-byte key (hex 64 chars or base64) for AES-256-GCM encryption of stored
# secrets (gateway webhook secrets, Meta tokens). REQUIRED in production —
# without it the app falls back to a hardcoded insecure dev key and /health
# reports secret_key_set=false (the alerts screen shows the pill red).
XACQORA_SECRET_KEY=<32-byte key, e.g. `openssl rand -hex 32`>

# --- Live mode (Phase L / H) --------------------------------------------------
# 1 = real Meta pulls + CAPI sends + HMAC-verified gateway webhooks; unset/0
# (or MOCK=1) = full mock/dry-run (the safe default for dev + staging).
XACQORA_LIVE=1
MOCK=0
#
# --- Meta live connect (pull) -------------------------------------------------
# The system-user token is stored PER ad account in meta_ad_account.token
# (encrypted at rest with XACQORA_SECRET_KEY); on startup the server reads
# these vars and upserts them onto the listed account rows (server/lib/
# metalive.js). Fill only the token + account ids; "start the server" is the
# whole workflow. CAPI stays dry-run (settings.capi, the alerts-screen toggle)
# until the pilot cutover — never set both in the same step.
# Where to get each value: docs/meta-live-connect.md (the 3-point list).
META_ACCESS_TOKEN=           # Business Suite > System Users > Generate Token (ads_read)
META_AD_ACCOUNT_IDS=         # ACT_123,ACT_456 — from /me/adaccounts or Ads Manager
META_PIXEL_ID=              # optional CAPI dataset id (Events Manager > Data Sources)
#META_AD_ACCOUNT_NAME=      # optional row label
#META_CLIENT_ID=1           # which client owns the account rows (default 1)
# Record token expiry on the rows (so /alerts warns 48h ahead):
#   node scripts/meta-validate.js
# Shared secret the cron uses to trigger queue drains on a serverless host
# (POST /admin/tick, header x-xacqora-tick-secret). Set on Vercel; self-hosted
# runs keep the in-process ticker and never need it.
XACQORA_TICK_SECRET=<random 32+ chars>

# --- DATA_MODE (v9) -----------------------------------------------------------
# Which data population the screens show:
#   live = real rows only (seed/demo fixtures excluded, clean empty states,
#          demo band off) — the prod default;
#   demo = seed fixtures + real rows together (the yellow "Demo data" band on).
# Resolution: an admin toggle (Admin → Data mode, audit-logged) OVERRIDES this;
# with no toggle the env value applies.
DATA_MODE=live

# --- Tracking script subdomain (Phase H) ---------------------------------------
# Host xt.js on your own subdomain (CDN/Vercel project) so third-party CSP
# pages (Meta-hosted, Lovable, WordPress with strict CSP) can load it:
XACQORA_XT_SUBDOMAIN=track.yourdomain.com

# --- Rate limits (Phase S.6) ---------------------------------------------------
# Generous per-endpoint cap + strict per-IP flood guard (defaults 300 / 600).
XT_RATE_PER_MIN_ENDPOINT=300
XT_RATE_PER_MIN_IP=600

# --- Deployment knobs -----------------------------------------------------------
PORT=4100
# Serverless only: disable the in-process ticker; Vercel Cron drives /admin/tick.
XT_DISABLE_TICKER=1
